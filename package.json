{
  "name": "change-firewall",
  "version": "0.3.1",
  "description": "The deterministic trust layer for autonomous AI coding agents. Compiler-grounded verification of what an agent actually did vs. what it claimed, blast radius mapping, and persistent contract memory.",
  "type": "module",
  "bin": {
    "change-firewall": "bin/change-firewall.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "README.md",
    "Readme.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "verify:mcp": "node scripts/verify-mcp-e2e.mjs",
    "prepublishOnly": "npm run build && npm run verify:mcp"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "cursor-agent",
    "windsurf",
    "agentic-coding",
    "ai-coding-agents",
    "ai-agent-verification",
    "trust-layer",
    "code-review",
    "ast-diff",
    "git-diff",
    "blast-radius",
    "static-analysis",
    "symbolic-execution",
    "crash-proof",
    "merge-gate",
    "pre-commit",
    "developer-tools",
    "typescript"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Himanshu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/himanshYou2003/change-firewall.git"
  },
  "bugs": {
    "url": "https://github.com/himanshYou2003/change-firewall/issues"
  },
  "homepage": "https://change-firewall.vercel.app/",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^13.1.0",
    "open": "^10.1.0",
    "picocolors": "^1.1.1",
    "typescript": "^5.7.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsup": "^8.3.6",
    "vitest": "^3.0.7"
  }
}
