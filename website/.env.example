# MongoDB Connection String (configured for Cluster0 on Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xl66df9.mongodb.net/?appName=Cluster0

# Public URL of the separately running playground gateway.
# Keep this unset when no runtime is available; the IDE then stays in an honest
# preview-only state and does not simulate command results.
NEXT_PUBLIC_PLAYGROUND_GATEWAY_URL=http://127.0.0.1:8787
